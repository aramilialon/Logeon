{
  "id": "logeon.archetypes",
  "name": "Archetipi",
  "version": "0.1.0",
  "vendor": "Logeon",
  "description": "Modulo Archetipi: provider runtime agganciato via hook character.archetype.provider.",
  "privacy": {
    "personal_data": false,
    "data_categories": [],
    "purposes": [],
    "retention": "inherits_instance_policy",
    "requires_consent": false,
    "exports_user_data": false,
    "supports_purge": true
  },
  "category": "gameplay",
  "class": "bundled",
  "compat": {
    "min": "1.0.0",
    "max": ""
  },
  "requires": [],
  "entrypoints": {
    "bootstrap": "bootstrap.php",
    "routes": "routes.php"
  },
  "migrations": {
    "path": "migrations"
  },
  "uninstall": {
    "path": "migrations/uninstall"
  },
  "menus": {
    "public": {
      "navbar": [
        {
          "label": "Archetipi",
          "href": "/archetypes",
          "icon": "bi bi-person-badge",
          "order": 30
        }
      ]
    },
    "game": {
      "info_dropdown": [
        {
          "label": "Archetipi",
          "href": "/game/archetypes",
          "icon": "bi bi-person-badge",
          "order": 220
        }
      ],
      "info_offcanvas": [
        {
          "label": "Archetipi",
          "href": "/game/archetypes",
          "icon": "bi bi-person-badge",
          "order": 220
        }
      ]
    },
    "admin": {
      "aside": [
        {
          "label": "Archetipi",
          "href": "/admin/archetypes",
          "icon": "",
          "page": "archetypes",
          "section": "Parametri ed entita",
          "section_order": 20,
          "order": 120
        }
      ]
    }
  },
  "features": [
    "character.archetype.provider.override",
    "archetypes.public.docs.route",
    "settings.docs_view_mode.provider"
  ],
  "assets": {
    "admin": {
      "js": ["dist/admin.js"]
    },
    "game": {
      "js": ["dist/game.js"]
    }
  }
}
