{
  "id": "logeon.novelty",
  "name": "Novità",
  "version": "0.1.0",
  "vendor": "Logeon",
  "description": "Modulo news: feed homepage e API news agganciati via runtime moduli.",
  "privacy": {
    "personal_data": false,
    "data_categories": [],
    "purposes": [],
    "retention": "inherits_instance_policy",
    "requires_consent": false,
    "exports_user_data": false,
    "supports_purge": true
  },
  "category": "gameplay",
  "class": "bundled",
  "compat": {
    "min": "1.0.0",
    "max": ""
  },
  "requires": [],
  "entrypoints": {
    "bootstrap": "bootstrap.php",
    "routes": "routes.php"
  },
  "migrations": {
    "path": "migrations"
  },
  "uninstall": {
    "path": "migrations/uninstall"
  },
  "menus": {
    "admin": {
      "aside": [
        {
          "label": "News",
          "href": "/admin/news",
          "icon": "",
          "page": "news",
          "section": "Comunicazione",
          "section_order": 45,
          "order": 100
        }
      ]
    }
  },
  "features": [
    "landing.module_feed",
    "novelty.routes",
    "notifications.preference_mapping",
    "character.settings.notification_preferences"
  ]
}
