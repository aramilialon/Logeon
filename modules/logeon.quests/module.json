    "requires_consent": false,
    "exports_user_data": false,
    "supports_purge": true
  },
  "category": "gameplay",
  "class": "bundled",
  "compat": {
    "min": "1.0.0",
    "max": ""
  },
  "requires": [],
  "entrypoints": {
    "bootstrap": "bootstrap.php",
    "routes": "routes.php"
  },
  "migrations": {
    "path": "migrations"
  },
  "uninstall": {
    "path": "migrations/uninstall"
  },
  "assets": {
    "admin": {
      "js": ["dist/admin.js"]
    },
    "game": {
      "js": ["dist/game.js"]
    }
  },
  "menus": {
    "admin": {
      "aside": [
        {
          "label": "Quest",
          "href": "/admin/quests",
          "icon": "",
          "page": "quests",
          "section": "Narrativa",
          "section_order": 50,
          "order": 120
        }
      ]
    }
  },
  "features": [
    "quests.triggers",
    "quests.routes",
    "quests.admin.routes",
    "quests.game.history.route",
    "quests.twig.slots",
    "quests.views",
    "landing.metrics.provider",
    "system_event.delete.related_cleanup",
    "narrative_tags.entity_provider"
  ],
  "privacy": {
    "personal_data": true,
    "data_categories": [
      "character_progression",
      "quest_history"
    ],
    "purposes": [
      "gameplay_progress_tracking"
