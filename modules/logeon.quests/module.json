{
  "id": "logeon.quests",
  "name": "Missioni",
  "version": "0.1.0",
  "vendor": "Logeon",
  "description": "Modulo Quest: trigger runtime e API missioni/admin.",
  "privacy": {
    "personal_data": false,
    "data_categories": [],
    "purposes": [],
