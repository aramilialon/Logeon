{% set is_staff_quests = (session('user_is_administrator') == 1 or session('user_is_moderator') == 1 or session('user_is_master') == 1) %}

<div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasQuests" aria-labelledby="offcanvasQuestsLabel"
     style="--bs-offcanvas-width: min(680px, 95vw);">
    <div class="offcanvas-header quest-panel__header">
        <div>
            <div class="quest-panel__eyebrow">Mandati attivi</div>
            <h5 class="offcanvas-title quest-panel__title" id="offcanvasQuestsLabel">
                <i class="bi bi-journal-text me-2"></i>Quest
            </h5>
        </div>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Chiudi"></button>
    </div>

    <div class="offcanvas-body p-0 d-flex" style="overflow:hidden; height:100%;">

        {# ── Sidebar sinistra: filtri + lista ── #}
        <div class="quest-sidebar">
            <div class="quest-sidebar__toolbar">
                <select id="quests-status-filter" class="form-select form-select-sm">
                    <option value="">Tutti gli stati</option>
                    <option value="available">Disponibile</option>
                    <option value="active">Attiva</option>
                    <option value="completed">Completata</option>
                    <option value="failed">Fallita</option>
                </select>
                <select id="quests-scope-filter" class="form-select form-select-sm">
                    <option value="">Tutti gli ambiti</option>
                    <option value="world">Mondo</option>
                    <option value="character">Personaggio</option>
                    <option value="faction">Fazione</option>
                    <option value="guild">Gilda</option>
                </select>
                <select id="quests-tag-filter" class="form-select form-select-sm">
                    <option value="">Tutti i tag</option>
                </select>
                <div class="d-flex gap-1">
                    <a href="/game/quests/history" class="btn btn-sm btn-outline-secondary flex-grow-1"
                       data-bs-toggle="tooltip" data-bs-title="Archivio">
                        <i class="bi bi-clock-history"></i>
                    </a>
                    {% if is_staff_quests %}
                        <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1" data-action="quests-open-staff"
                                data-bs-toggle="tooltip" data-bs-title="Staff">
                            <i class="bi bi-shield-lock"></i>
                        </button>
                    {% endif %}
                    <button type="button" class="btn btn-sm btn-outline-secondary flex-grow-1" data-action="quests-reload"
                            data-bs-toggle="tooltip" data-bs-title="Aggiorna">
                        <i class="bi bi-arrow-clockwise"></i>
                    </button>
                </div>
            </div>

            <div id="quests-loading" class="text-center py-4 text-muted small d-none">
                Caricamento...
            </div>
            <div id="quests-empty" class="text-center py-4 text-muted small d-none">
                Nessuna quest.
            </div>
            <div id="quests-list" class="quest-sidebar__list"></div>
        </div>

        {# ── Pannello destro: dettaglio ── #}
        <div id="quest-detail-panel" class="quest-detail-panel">
            <div class="quest-detail-panel__empty">
                <span class="bi bi-journal-text"></span>
                <span>Seleziona una quest</span>
            </div>
        </div>

    </div>
</div>

{% if is_staff_quests %}
<div class="modal fade" id="quest-staff-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">

            <div class="modal-header">
                <div>
                    <div class="quest-panel__eyebrow">Pannello Staff</div>
                    <h5 class="modal-title">
                        <i class="bi bi-shield-lock me-2"></i>Strumenti Quest
                    </h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>

            <div class="modal-body p-0" style="overflow:hidden;">
                <div class="row g-0" style="min-height:560px;">

                    {# ── Colonna sinistra: filtri + lista istanze ── #}
                    <div class="col-lg-4 d-flex flex-column quest-staff-col-left">
                        <div class="p-3 quest-staff-col-filter-header">
                            <div class="quest-panel__eyebrow mb-2">Filtra istanze</div>
                            <div class="d-flex flex-column gap-2">
                                <select id="quest-staff-status-filter" class="form-select form-select-sm">
                                    <option value="">Tutti gli stati</option>
                                    <option value="active">Attive</option>
                                    <option value="available">Disponibili</option>
                                    <option value="completed">Completate</option>
                                    <option value="failed">Fallite</option>
                                </select>
                                <select id="quest-staff-assignee-filter" class="form-select form-select-sm">
                                    <option value="">Tutti gli assegnatari</option>
                                    <option value="character">Personaggio</option>
                                    <option value="faction">Fazione</option>
                                    <option value="guild">Gilda</option>
                                    <option value="world">Mondo</option>
                                </select>
                                <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-action="quest-staff-reload">
                                    <i class="bi bi-arrow-clockwise me-1"></i>Aggiorna
                                </button>
                            </div>
                        </div>
                        <div id="quest-staff-list" class="list-group list-group-flush overflow-auto flex-grow-1" style="max-height:460px;"></div>
                    </div>

                    {# ── Colonna destra: azioni ── #}
                    <div class="col-lg-8 overflow-auto p-3 d-flex flex-column gap-3 quest-staff-col-right">

                        {# — Blocco: azione rapida — #}
                        <div class="quest-staff-panel">
                            <div class="quest-staff-panel__header">
                                <span class="quest-panel__eyebrow">Azione rapida</span>
                                <span class="quest-staff-panel__title"><i class="bi bi-sliders me-1"></i>Istanza selezionata</span>
                            </div>
                            <div class="quest-staff-panel__body">
                                <input type="hidden" id="quest-staff-instance-id" value="0">
                                <div class="row g-2">
                                    <div class="col-12">
                                        <label class="form-label form-label-sm">Istanza</label>
                                        <input type="text" id="quest-staff-instance-label" class="form-control form-control-sm" readonly placeholder="Seleziona un'istanza dalla colonna sinistra">
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label form-label-sm">Stato istanza</label>
                                        <select id="quest-staff-instance-status" class="form-select form-select-sm">
                                            <option value="available">Disponibile</option>
                                            <option value="active">Attiva</option>
                                            <option value="completed">Completata</option>
                                            <option value="failed">Fallita</option>
                                            <option value="cancelled">Annullata</option>
                                            <option value="expired">Scaduta</option>
                                        </select>
                                    </div>
                                    <div class="col-6 d-flex align-items-end">
                                        <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-action="quest-staff-set-status">
                                            <i class="bi bi-check2 me-1"></i>Imposta stato
                                        </button>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label form-label-sm">Step</label>
                                        <select id="quest-staff-step-id" class="form-select form-select-sm">
                                            <option value="">Seleziona uno step</option>
                                        </select>
                                    </div>
                                    <div class="col-6">
                                        <label class="form-label form-label-sm">Esito step</label>
                                        <select id="quest-staff-step-status" class="form-select form-select-sm">
                                            <option value="completed">Completato</option>
                                            <option value="failed">Fallito</option>
                                            <option value="active">Attivo</option>
                                            <option value="skipped">Saltato</option>
                                        </select>
                                    </div>
                                </div>
                                <div class="d-flex justify-content-between align-items-center mt-3 pt-2 quest-divider-top">
                                    <button type="button" class="btn btn-sm btn-outline-warning" data-action="quest-staff-force-progress">
                                        <i class="bi bi-skip-forward me-1"></i>Forza avanzamento
                                    </button>
                                    <button type="button" class="btn btn-sm btn-primary" data-action="quest-staff-confirm-step">
                                        <i class="bi bi-check-circle me-1"></i>Conferma step
                                    </button>
                                </div>
                            </div>
                        </div>

                        {# — Blocco: chiusura e ricompense — #}
                        <div class="quest-staff-panel">
                            <div class="quest-staff-panel__header">
                                <span class="quest-panel__eyebrow">Conclusione</span>
                                <div class="d-flex align-items-center gap-2">
                                    <span class="quest-staff-panel__title"><i class="bi bi-trophy me-1"></i>Chiusura quest e ricompense</span>
                                    <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-action="quest-staff-load-closure" style="padding:2px 8px;">
                                        <i class="bi bi-arrow-clockwise"></i>
                                    </button>
                                </div>
                            </div>
                            <div class="quest-staff-panel__body">
                                <div class="row g-2">
                                    <div class="col-6 col-md-3">
                                        <label class="form-label form-label-sm">Stato finale</label>
                                        <select id="quest-staff-final-status" class="form-select form-select-sm">
                                            <option value="completed">Completata</option>
                                            <option value="failed">Fallita</option>
                                            <option value="cancelled">Annullata</option>
                                            <option value="expired">Scaduta</option>
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label form-label-sm">Tipo chiusura</label>
                                        <select id="quest-staff-closure-type" class="form-select form-select-sm">
                                            <option value="success">Successo</option>
                                            <option value="partial_success">Parziale</option>
                                            <option value="failure">Fallimento</option>
                                            <option value="cancelled">Annullata</option>
                                            <option value="unresolved">Non risolta</option>
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label form-label-sm">Visibile al player</label>
                                        <select id="quest-staff-player-visible" class="form-select form-select-sm">
                                            <option value="1">Sì</option>
                                            <option value="0">No</option>
                                        </select>
                                    </div>
                                    <div class="col-6 col-md-3">
                                        <label class="form-label form-label-sm">Etichetta esito</label>
                                        <input type="text" id="quest-staff-outcome-label" class="form-control form-control-sm" maxlength="120" placeholder="Esito">
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label form-label-sm">Summary pubblico</label>
                                        <textarea id="quest-staff-summary-public" class="form-control form-control-sm" rows="2" placeholder="Visibile nello storico player"></textarea>
                                    </div>
                                    <div class="col-12 col-md-6">
                                        <label class="form-label form-label-sm">Summary privato</label>
                                        <textarea id="quest-staff-summary-private" class="form-control form-control-sm" rows="2" placeholder="Note interne staff"></textarea>
                                    </div>
                                    <div class="col-12">
                                        <label class="form-label form-label-sm">Note staff</label>
                                        <textarea id="quest-staff-notes" class="form-control form-control-sm" rows="2"></textarea>
                                    </div>
                                </div>

                                <div class="mt-3 pt-2 quest-divider-top">
                                    <div class="quest-panel__eyebrow mb-2">Ricompense (opzionali)</div>
                                    <div class="row g-2">
                                        <div class="col-6 col-md-3">
                                            <label class="form-label form-label-sm">Esperienza</label>
                                            <input type="number" id="quest-staff-reward-exp" class="form-control form-control-sm" min="0" step="0.01" placeholder="0.00">
                                        </div>
                                        <div class="col-12 col-md-5">
                                            <label class="form-label form-label-sm">Oggetto</label>
                                            <input type="text" id="quest-staff-reward-item-label" class="form-control form-control-sm" autocomplete="off" placeholder="Cerca oggetto...">
                                            <input type="hidden" id="quest-staff-reward-item-id" value="0">
                                            <div id="quest-staff-reward-item-suggestions" class="list-group mt-1 d-none" style="font-size:.8rem;"></div>
                                        </div>
                                        <div class="col-4 col-md-2">
                                            <label class="form-label form-label-sm">Qtà</label>
                                            <input type="number" id="quest-staff-reward-item-qty" class="form-control form-control-sm" min="1" value="1">
                                        </div>
                                        <div class="col-8 col-md-2">
                                            <label class="form-label form-label-sm">Visibilità</label>
                                            <select id="quest-staff-reward-visibility" class="form-select form-select-sm">
                                                <option value="public">Pubblica</option>
                                                <option value="player_private">Player</option>
                                                <option value="staff_only">Staff</option>
                                            </select>
                                        </div>
                                    </div>

                                    <div class="d-flex justify-content-end gap-2 mt-3">
                                        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="quest-staff-load-closure">
                                            <i class="bi bi-arrow-clockwise me-1"></i>Ricarica
                                        </button>
                                        <button type="button" class="btn btn-sm btn-success" data-action="quest-staff-finalize">
                                            <i class="bi bi-check2-circle me-1"></i>Concludi quest
                                        </button>
                                    </div>

                                    <div class="mt-3">
                                        <div class="quest-panel__eyebrow mb-2">Ricompense assegnate</div>
                                        <div id="quest-staff-rewards-list" class="list-group list-group-flush"></div>
                                    </div>
                                </div>
                            </div>
                        </div>

                    </div>{# /col destra #}
                </div>{# /row #}
            </div>{# /modal-body #}

        </div>
    </div>
</div>
{% endif %}
