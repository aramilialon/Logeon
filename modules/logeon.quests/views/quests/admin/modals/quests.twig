{# ── Dettaglio quest ──────────────────────────────────────── #}
<div class="modal fade" id="admin-quest-detail-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="quest-panel__eyebrow">Strumenti</div>
                    <h5 class="modal-title"><i class="bi bi-journal-bookmark me-2"></i>Dettaglio quest</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <div class="d-flex flex-wrap gap-1 mb-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quests-open-steps" data-role="admin-quests-detail-action" disabled><i class="bi bi-diagram-2 me-1"></i>Step</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quests-open-conditions" data-role="admin-quests-detail-action" disabled><i class="bi bi-funnel me-1"></i>Condizioni</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quests-open-outcomes" data-role="admin-quests-detail-action" disabled><i class="bi bi-lightning me-1"></i>Esiti</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quests-open-links" data-role="admin-quests-detail-action" disabled><i class="bi bi-link-45deg me-1"></i>Link eventi</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quests-open-instances" data-role="admin-quests-detail-action" disabled><i class="bi bi-people me-1"></i>Istanze</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quests-open-closures" data-role="admin-quests-detail-action" disabled><i class="bi bi-flag me-1"></i>Chiusure</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quests-open-rewards" data-role="admin-quests-detail-action" disabled><i class="bi bi-trophy me-1"></i>Ricompense</button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quests-open-logs" data-role="admin-quests-detail-action" disabled><i class="bi bi-clock-history me-1"></i>Log</button>
                </div>
                <div id="admin-quest-detail-empty" class="small text-muted">Seleziona una quest dalla tabella per vedere i dettagli.</div>
                <div id="admin-quest-detail" class="d-none"></div>
            </div>
        </div>
    </div>
</div>

{# ── Step quest ───────────────────────────────────────────── #}
<div class="modal fade" id="admin-quest-steps-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="quest-panel__eyebrow">Struttura</div>
                    <h5 class="modal-title"><i class="bi bi-diagram-2 me-2"></i>Step quest</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body d-flex flex-column gap-3">

                <div class="quest-staff-panel">
                    <div class="quest-staff-panel__header">
                        <span class="quest-panel__eyebrow">Elenco</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="quest-staff-panel__title"><i class="bi bi-list-ol me-1"></i>Step configurati</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-action="admin-quest-steps-reload" style="padding:2px 8px;"><i class="bi bi-arrow-clockwise"></i></button>
                        </div>
                    </div>
                    <div class="quest-staff-panel__body p-0">
                        <div id="admin-quest-steps-list" class="list-group list-group-flush"></div>
                    </div>
                </div>

                <div class="quest-staff-panel">
                    <div class="quest-staff-panel__header">
                        <span class="quest-panel__eyebrow">Editor</span>
                        <span class="quest-staff-panel__title"><i class="bi bi-pencil-square me-1"></i>Crea / modifica step</span>
                    </div>
                    <div class="quest-staff-panel__body">
                        <form id="admin-quest-step-form" class="row g-2">
                            <input type="hidden" name="step_id" value="0">
                            <div class="col-12 col-md-3">
                                <label class="form-label form-label-sm">Identificatore step</label>
                                <input type="text" class="form-control form-control-sm" name="step_key" maxlength="80" placeholder="es. step_intro">
                                <div class="form-text">Slug interno usato dal sistema per tracciare il progresso. Non visibile ai player.</div>
                            </div>
                            <div class="col-12 col-md-5">
                                <label class="form-label form-label-sm">Titolo</label>
                                <input type="text" class="form-control form-control-sm" name="title" maxlength="255">
                                <div class="form-text">Nome dello step visibile nello storico e nei pannelli staff.</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label form-label-sm">Tipo</label>
                                <select class="form-select form-select-sm" name="step_type">
                                    <option value="action">Azione</option>
                                    <option value="dialogue">Dialogo</option>
                                    <option value="checkpoint">Checkpoint</option>
                                    <option value="system">Sistema</option>
                                </select>
                                <div class="form-text"><b>action</b> = interazione attiva; <b>dialogue</b> = scena narrativa; <b>checkpoint</b> = passaggio automatico; <b>system</b> = gestito dal motore.</div>
                            </div>
                            <div class="col-12 col-md-1">
                                <label class="form-label form-label-sm">Ordine</label>
                                <input type="number" class="form-control form-control-sm" name="order_index" min="0" value="0">
                                <div class="form-text">Usa valori con gap (10, 20, 30…) per facilitare inserimenti futuri.</div>
                            </div>
                            <div class="col-12 col-md-1">
                                <label class="form-label form-label-sm">Opzionale</label>
                                <select class="form-select form-select-sm" name="is_optional">
                                    <option value="0">No</option>
                                    <option value="1">Si</option>
                                </select>
                                <div class="form-text">Se Sì, il fallimento di questo step non blocca il completamento della quest.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label form-label-sm">Descrizione</label>
                                <textarea class="form-control form-control-sm richtext-editor" name="description" rows="2"></textarea>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quest-step-reset">Reset</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quest-step-reorder"><i class="bi bi-sort-numeric-down me-1"></i>Salva ordine</button>
                <button type="button" class="btn btn-sm btn-primary" data-action="admin-quest-step-save"><i class="bi bi-floppy me-1"></i>Salva step</button>
            </div>
        </div>
    </div>
</div>

{# ── Condizioni quest ─────────────────────────────────────── #}
<div class="modal fade" id="admin-quest-conditions-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="quest-panel__eyebrow">Logica</div>
                    <h5 class="modal-title"><i class="bi bi-funnel me-2"></i>Condizioni quest</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body d-flex flex-column gap-3">

                <div class="quest-staff-panel">
                    <div class="quest-staff-panel__header">
                        <span class="quest-panel__eyebrow">Elenco</span>
                        <div class="d-flex align-items-center gap-2 w-100">
                            <span class="quest-staff-panel__title"><i class="bi bi-list-check me-1"></i>Condizioni configurate</span>
                            <select id="admin-quest-condition-step-filter" class="form-select form-select-sm ms-auto" style="width:auto;">
                                <option value="0">Tutti gli step</option>
                            </select>
                            <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quest-conditions-reload" style="padding:2px 8px;"><i class="bi bi-arrow-clockwise"></i></button>
                        </div>
                    </div>
                    <div class="quest-staff-panel__body p-0">
                        <div id="admin-quest-conditions-list" class="list-group list-group-flush"></div>
                    </div>
                </div>

                <div class="quest-staff-panel">
                    <div class="quest-staff-panel__header">
                        <span class="quest-panel__eyebrow">Editor</span>
                        <span class="quest-staff-panel__title"><i class="bi bi-pencil-square me-1"></i>Crea / modifica condizione</span>
                    </div>
                    <div class="quest-staff-panel__body">
                        <form id="admin-quest-condition-form" class="row g-2">
                            <input type="hidden" name="condition_id" value="0">

                            <div class="col-12">
                                <div class="small text-uppercase text-muted fw-semibold mb-1">1. Dove si applica</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label form-label-sm">Step</label>
                                <select class="form-select form-select-sm" name="quest_step_definition_id" data-role="admin-quest-condition-step-id">
                                    <option value="0">Condizione di quest</option>
                                </select>
                                <div class="form-text">Lascia "Condizione di quest" se la condizione vale sull'intera quest, non su un singolo step.</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label form-label-sm">Tipo trigger</label>
                                <select class="form-select form-select-sm" name="condition_type">
                                    <option value="manual_staff">Manuale staff</option>
                                    <option value="narrative.event.created">Evento narrativo</option>
                                    <option value="system_event.status_changed">Evento di sistema</option>
                                    <option value="faction.membership.changed">Membership fazione</option>
                                    <option value="lifecycle.phase.entered">Ciclo vita</option>
                                    <option value="presence.position_changed">Cambio posizione</option>
                                    <option value="quest_lifecycle">Ciclo vita quest</option>
                                </select>
                                <div class="form-text"><b>manual_staff</b> richiede conferma esplicita; gli altri scattano automaticamente all'evento.</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label form-label-sm">Attiva</label>
                                <select class="form-select form-select-sm" name="is_active">
                                    <option value="1">Si</option>
                                    <option value="0">No</option>
                                </select>
                            </div>

                            <div class="col-12 mt-1">
                                <div class="small text-uppercase text-muted fw-semibold mb-1">2. Come viene valutata</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label form-label-sm">Operatore</label>
                                <select class="form-select form-select-sm" name="operator">
                                    <option value="eq">Uguale (=)</option>
                                    <option value="ne">Diverso (&ne;)</option>
                                    <option value="in">Incluso in</option>
                                    <option value="not_in">Escluso da</option>
                                    <option value="gt">Maggiore di (&gt;)</option>
                                    <option value="gte">Maggiore o uguale (&ge;)</option>
                                    <option value="lt">Minore di (&lt;)</option>
                                    <option value="lte">Minore o uguale (&le;)</option>
                                    <option value="contains">Contiene</option>
                                </select>
                                <div class="form-text">Come viene confrontato il valore del payload con quello atteso.</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label form-label-sm">Modalità</label>
                                <select class="form-select form-select-sm" name="evaluation_mode">
                                    <option value="all_required">Tutte necessarie</option>
                                    <option value="any_required">Almeno una</option>
                                    <option value="blocking">Bloccante</option>
                                    <option value="optional">Opzionale</option>
                                </select>
                                <div class="form-text"><b>all_required</b> = tutte vere; <b>any_required</b> = basta una; <b>blocking</b> = blocca il progresso se non soddisfatta.</div>
                            </div>

                            <div class="col-12 mt-1">
                                <div class="small text-uppercase text-muted fw-semibold mb-1">3. Campo e valore del payload</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label form-label-sm">Campo payload (guidato)</label>
                                <select class="form-select form-select-sm" name="field_key_preset" data-role="admin-quest-condition-field-key-preset">
                                    <option value="">Nessun campo</option>
                                    <option value="event_type">Tipo evento</option>
                                    <option value="status">Stato</option>
                                    <option value="phase">Fase</option>
                                    <option value="membership_action">Azione membership</option>
                                    <option value="member_role">Ruolo membro</option>
                                    <option value="map_id">Mappa</option>
                                    <option value="location_id">Luogo</option>
                                    <option value="custom">Altro (avanzato)</option>
                                </select>
                                <input type="text" class="form-control form-control-sm mt-1 d-none" name="field_key_custom" maxlength="120" placeholder="Campo personalizzato...">
                                <input type="hidden" name="field_key" value="">
                                <div class="form-text">Campo del payload dell'evento da ispezionare (es. <code>status</code>, <code>event_type</code>).</div>
                            </div>
                            <div class="col-12 col-md-8">
                                <label class="form-label form-label-sm">Valore payload (guidato)</label>
                                <select class="form-select form-select-sm" name="field_value_preset" data-role="admin-quest-condition-value-preset">
                                    <option value="">Nessun valore</option>
                                    <option value="active">Attivo</option>
                                    <option value="completed">Completato</option>
                                    <option value="failed">Fallito</option>
                                    <option value="scheduled">Pianificato</option>
                                    <option value="cancelled">Annullato</option>
                                    <option value="joined">Aderisce</option>
                                    <option value="left">Ha lasciato</option>
                                    <option value="role_changed">Ruolo cambiato</option>
                                    <option value="custom">Altro (avanzato)</option>
                                </select>
                                <input type="text" class="form-control form-control-sm mt-1 d-none" name="field_value_custom" maxlength="255" placeholder="Valore personalizzato...">
                                <input type="hidden" name="field_value" value="">
                                <div class="form-text">Valore atteso nel campo. Per operatori <code>in</code> e <code>not_in</code> usa valori separati da virgola nel campo avanzato.</div>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-quest-condition-reset">Reset</button>
                <button type="button" class="btn btn-sm btn-primary" data-action="admin-quest-condition-save"><i class="bi bi-floppy me-1"></i>Salva condizione</button>
            </div>
        </div>
    </div>
</div>

{# ── Esiti quest ──────────────────────────────────────────── #}
<div class="modal fade" id="admin-quest-outcomes-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <div>
                    <div class="quest-panel__eyebrow">Effetti</div>
                    <h5 class="modal-title"><i class="bi bi-lightning me-2"></i>Esiti quest</h5>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body d-flex flex-column gap-3">

                <div class="quest-staff-panel">
                    <div class="quest-staff-panel__header">
                        <span class="quest-panel__eyebrow">Elenco</span>
                        <div class="d-flex align-items-center gap-2">
                            <span class="quest-staff-panel__title"><i class="bi bi-list-check me-1"></i>Esiti configurati</span>
                            <button type="button" class="btn btn-sm btn-outline-secondary ms-auto" data-action="admin-quest-outcomes-reload" style="padding:2px 8px;"><i class="bi bi-arrow-clockwise"></i></button>
                        </div>
                    </div>
                    <div class="quest-staff-panel__body p-0">
                        <div id="admin-quest-outcomes-list" class="list-group list-group-flush"></div>
                    </div>
                </div>

                <div class="quest-staff-panel">
                    <div class="quest-staff-panel__header">
                        <span class="quest-panel__eyebrow">Editor</span>
                        <span class="quest-staff-panel__title"><i class="bi bi-pencil-square me-1"></i>Crea / modifica esito</span>
                    </div>
                    <div class="quest-staff-panel__body">
                        <form id="admin-quest-outcome-form" class="row g-2">
                            <input type="hidden" name="outcome_id" value="0">

                            <div class="col-12">
                                <div class="small text-uppercase text-muted fw-semibold mb-1">1. Quando scatta</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label form-label-sm">Trigger</label>
                                <select class="form-select form-select-sm" name="trigger_type">
                                    <option value="step_completed">Step completato</option>
                                    <option value="quest_completed">Quest completata</option>
                                    <option value="quest_failed">Quest fallita</option>
                                    <option value="manual_staff">Manuale staff</option>
                                </select>
                                <div class="form-text">Evento che fa scattare automaticamente questo esito.</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label form-label-sm">Ordine</label>
                                <input type="number" class="form-control form-control-sm" name="sort_order" min="0" value="0">
                                <div class="form-text">Se più esiti condividono lo stesso trigger, questo determina la sequenza.</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label form-label-sm">Conferma staff</label>
                                <select class="form-select form-select-sm" name="requires_staff_confirmation">
                                    <option value="0">No</option>
                                    <option value="1">Si</option>
                                </select>
                                <div class="form-text">Se Sì, l'esito entra in coda e attende approvazione staff prima di essere applicato.</div>
                            </div>

                            <div class="col-12 mt-1">
                                <div class="small text-uppercase text-muted fw-semibold mb-1">2. Cosa produce</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label form-label-sm">Tipo esito</label>
                                <select class="form-select form-select-sm" name="outcome_type">
                                    <option value="log_progress">Registra progressione</option>
                                    <option value="notify">Notifica</option>
                                    <option value="create_narrative_event">Crea evento narrativo</option>
                                    <option value="unlock_quest">Sblocca quest</option>
                                    <option value="complete_quest">Completa quest</option>
                                    <option value="fail_quest">Fallisci quest</option>
                                    <option value="apply_narrative_state">Applica stato narrativo</option>
                                    <option value="remove_narrative_state">Rimuovi stato narrativo</option>
                                </select>
                                <div class="form-text">Effetto concreto prodotto dall'esito quando scatta.</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label form-label-sm">Visibilità</label>
                                <select class="form-select form-select-sm" name="visibility">
                                    <option value="hidden">Nascosta</option>
                                    <option value="public">Pubblica</option>
                                    <option value="private">Privata</option>
                                    <option value="staff_only">Solo staff</option>
                                </select>
                                <div class="form-text"><b>hidden</b> = mai visibile; <b>public</b> = tutti; <b>private</b> = solo il player assegnato; <b>staff_only</b> = solo staff.</div>
                            </div>

                            <div class="col-12 mt-1">
                                <div class="small text-uppercase text-muted fw-semibold mb-1">3. Parametri per tipo</div>
                            </div>
                            <div class="col-12 col-md-6">
                                <label class="form-label form-label-sm">Quest target (guidato)</label>
                                <input type="text" class="form-control form-control-sm" name="target_quest_label" autocomplete="off" placeholder="Cerca quest..." data-role="admin-quest-outcome-target-label">
                                <input type="hidden" name="target_quest_definition_id" value="0">
                                <div class="list-group mt-1 d-none" data-role="admin-quest-outcome-target-suggestions"></div>
                                <div class="form-text">Richiesto solo per esiti <code>unlock_quest</code> e <code>complete_quest</code>.</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label form-label-sm">Tipo evento narrativo</label>
                                <select class="form-select form-select-sm" name="narrative_event_type">
                                    <option value="">Nessuno</option>
                                    <option value="quest_update">Aggiornamento quest</option>
                                    <option value="quest_started">Quest avviata</option>
                                    <option value="quest_step_completed">Step completato</option>
                                    <option value="quest_completed">Quest completata</option>
                                    <option value="quest_failed">Quest fallita</option>
                                    <option value="quest_unlocked">Quest sbloccata</option>
                                    <option value="staff_note">Nota staff</option>
                                </select>
                                <div class="form-text">Richiesto solo per esiti <code>create_narrative_event</code>.</div>
                            </div>
                            <div class="col-12 col-md-3">
                                <label class="form-label form-label-sm">Titolo evento narrativo</label>
                                <input type="text" class="form-control form-control-sm" name="narrative_event_title" maxlength="255">
                                <div class="form-text">Titolo della cronaca generata automaticamente dall'esito.</div>
                            </div>
                            <div class="col-12">
                                <label class="form-label form-label-sm">Messaggio / causale</label>
                                <textarea class="form-control form-control-sm richtext-editor" name="message" rows="2"></textarea>
                                <div class="form-text">Testo incluso nell'evento narrativo o nella notifica. Visibilità controllata dal campo sopra.</div>
                            </div>
                            <div class="col-12 col-md-4">
                                <label class="form-label form-label-sm">Stato narrativo (guidato)</label>
                                <input type="text" class="form-control form-control-sm" name="state_label" autocomplete="off" placeholder="Cerca stato narrativo..." data-role="admin-quest-outcome-state-label">
                                <input type="hidden" name="state_id" value="0">
                                <div class="list-group mt-1 d-none" data-role="admin-quest-outcome-state-suggestions"></div>
                                <div class="form-text">Richiesto per esiti <code>apply_narrative_state</code> e <code>remove_narrative_state</code>.</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label form-label-sm">Intensità</label>
                                <input type="number" class="form-control form-control-sm" name="intensity" min="0" step="0.1">
                                <div class="form-text">Forza applicata allo stato narrativo (opzionale).</div>
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label form-label-sm">Durata</label>
                                <input type="number" class="form-control form-control-sm" name="duration_value" min="0">
                            </div>
                            <div class="col-12 col-md-2">
                                <label class="form-label form-label-sm">Unità durata</label>
                                <select class="form-select form-select-sm" name="duration_unit">
                                    <option value="">-</option>
                                    <option value="scene">Scena</option>
                                    <option value="minute">Minuto</option>
                                    <option value="hour">Ora</option>
                                    <option value="day">Giorno</option>
