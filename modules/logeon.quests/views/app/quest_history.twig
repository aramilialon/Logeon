{% extends theme_shell('game', 'app/layouts/layout.twig') %}

{% block content %}
<main class="container" id="quests-history-page" data-game-page="quests-history" data-character-id="{{ character_id|default('') }}">
    <section class="ui-page pb-4">

        <header class="forum-page-header mt-3">
            <p class="forum-page-eyebrow">Mandati conclusi</p>
            <h4 class="forum-page-title">
                <i class="bi bi-clock-history me-2"></i>Archivio quest
            </h4>
            <p class="forum-page-desc">Cronologia completa delle quest concluse con esito e ricompense visibili.</p>
        </header>

        <div class="guild-panel mb-3">
            <div class="guild-panel__body">
                <div class="row g-2">
                    <div class="col-12 col-md-3">
                        <label class="form-label form-label-sm mb-1">Stato</label>
                        <select id="quests-history-filter-status" class="form-select form-select-sm">
                            <option value="">Chiuse (tutte)</option>
                            <option value="completed">Completate</option>
                            <option value="failed">Fallite</option>
                            <option value="cancelled">Annullate</option>
                            <option value="expired">Scadute</option>
                        </select>
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label form-label-sm mb-1">Dal</label>
                        <input id="quests-history-filter-from" type="date" class="form-control form-control-sm">
                    </div>
                    <div class="col-12 col-md-2">
                        <label class="form-label form-label-sm mb-1">Al</label>
                        <input id="quests-history-filter-to" type="date" class="form-control form-control-sm">
                    </div>
                    <div class="col-12 col-md-3">
                        <label class="form-label form-label-sm mb-1">Ricerca</label>
                        <input id="quests-history-filter-search" type="search" class="form-control form-control-sm" placeholder="Titolo quest...">
                    </div>
                    <div class="col-12 col-md-2 d-flex align-items-end justify-content-end">
                        <button type="button" class="btn btn-sm btn-outline-secondary w-100" data-action="quests-history-reload">
                            <i class="bi bi-arrow-clockwise me-1"></i>Aggiorna
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="guild-panel">
            <div class="guild-panel__body">
                <div id="quests-history-loading" class="small text-muted py-2 d-none">Caricamento...</div>
                <div id="quests-history-empty" class="small text-muted py-2 d-none">Nessuna quest nello storico per i filtri selezionati.</div>
                <div id="quests-history-list" class="list-group list-group-flush"></div>
                <div class="d-flex justify-content-end mt-3">
                    <button type="button" class="btn btn-sm btn-outline-secondary d-none" id="quests-history-more" data-action="quests-history-more">
                        Mostra altre
                    </button>
                </div>
            </div>
        </div>

    </section>
</main>

{% include 'app/modals/quest_history/quest_history.twig' %}
{% endblock %}
