<!DOCTYPE html>
<html lang="{{ APP.lang }}">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1, minimum-scale=1">
    <link rel="shortcut icon" href="/favicon.ico" type="image/x-icon">
    {% if PWA.enabled %}
    <link rel="manifest" href="{{ PWA.manifest_url }}">
    <meta name="theme-color" content="{{ PWA.theme_color }}">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="{{ PWA.short_name }}">
    {% if PWA.apple_touch_icon_path is not empty %}
    <link rel="apple-touch-icon" href="{{ PWA.apple_touch_icon_path }}">
    {% endif %}
    {% endif %}
    <meta name="title" content="{{ APP.name }}">
    <meta name="description" content="{{ APP.description }}">
    <meta name="csrf-token" content="{{ csrf_token }}">
    <meta name="app-config-availability-idle-minutes" content="{{ (session('config_availability_idle_minutes') is not empty) ? session('config_availability_idle_minutes') : 20 }}">
    <meta name="app-config-onlines-auto-toast" content="{{ (session('config_onlines_auto_toast') is not empty) ? session('config_onlines_auto_toast') : 0 }}">
    <meta name="app-config-location-chat-max-chars" content="{{ (session('config_location_chat_max_chars') is not empty) ? session('config_location_chat_max_chars') : 0 }}">
    <meta name="app-config-default-dice-faces" content="{{ (session('config_default_dice_faces') is not empty) ? session('config_default_dice_faces') : 20 }}">
    <script id="app-config-chat-commands" type="application/json">{{ CONFIG['chat_commands']|json_encode|raw }}</script>
    {% set core_module_endpoints = {
        equipmentSlotsList: '/admin/equipment-slots/list',
        equipmentSlotsCreate: '/admin/equipment-slots/create',
        equipmentSlotsUpdate: '/admin/equipment-slots/update',
        equipmentSlotsDelete: '/admin/equipment-slots/delete',
        itemEquipmentRulesList: '/admin/item-equipment-rules/list',
        itemEquipmentRulesCreate: '/admin/item-equipment-rules/create',
        itemEquipmentRulesUpdate: '/admin/item-equipment-rules/update',
        itemEquipmentRulesDelete: '/admin/item-equipment-rules/delete'
    } %}
    <script id="app-module-endpoints" type="application/json">{{ core_module_endpoints|merge(hook_map('app.module_endpoints', {}))|json_encode|raw }}</script>
    <script id="app-pwa-config" type="application/json">{{ PWA|json_encode|raw }}</script>
    {% set pilot_bundle_version = FRONTEND_ASSET_VERSION|default('20260403') %}
    <meta name="app-bundle-version" content="{{ pilot_bundle_version }}">

    <title>{{ APP.name }}</title>

    <link rel="stylesheet" href="/assets/vendor/bootstrap-5.3.8/dist/css/bootstrap.css?v={{ pilot_bundle_version }}">
    <link rel="stylesheet" href="/assets/vendor/bootstrap-icons-1.13.1/bootstrap-icons.css?v={{ pilot_bundle_version }}">
    <link rel="stylesheet" href="/assets/css/framework.css?v={{ pilot_bundle_version }}"></link>
    <link rel="stylesheet" href="/assets/css/style.css?v={{ pilot_bundle_version }}"></link>
    {% if THEME_CONTEXT == 'public' %}
    {{ theme_assets('public_css')|raw }}
    {% elseif THEME_CONTEXT == 'game' %}
    {{ theme_assets('game_css')|raw }}
    {% endif %}
    <link rel="stylesheet" href="/assets/css/custom.css?v={{ pilot_bundle_version }}"></link>

    <script type="text/javascript" src="/assets/js/jquery/jquery.min.js"></script>
    <script type="text/javascript" src="/assets/vendor/bootstrap-5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script type="module" src="/assets/js/dist/runtime-core.bundle.js?v={{ pilot_bundle_version }}"></script>
</head>

<body class="{{ theme_body_classes() }}" data-theme-active="{{ theme_active() ? '1' : '0' }}" data-theme-context="{{ THEME_CONTEXT }}"{% if theme_active() %} data-theme-id="{{ theme_id() }}"{% endif %}>
    <div id="app-boot-overlay" class="app-boot-overlay" aria-hidden="true">
        <div class="app-boot-overlay__panel" role="status" aria-live="polite">
            <div class="app-boot-overlay__pulse" aria-hidden="true">
                <span></span>
                <span></span>
                <span></span>
            </div>
            <div class="app-boot-overlay__title">Sto preparando l'interfaccia...</div>
            <div class="app-boot-overlay__subtitle">Caricamento in corso</div>
        </div>
    </div>
