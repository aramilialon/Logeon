<div
    id="cookie-banner"
    class="d-none"
    role="dialog"
    aria-label="Informativa cookie"
    data-cookie-policy-url="{{ APP.legal.cookie_policy_url|default('/cookie-policy') }}"
    data-cookie-policy-version="{{ APP.legal.cookie_policy_version|default('1.0.0') }}"
>
    <div class="container py-2">
        <div class="d-flex flex-column gap-2">
            <div class="d-flex align-items-start justify-content-between gap-3 flex-wrap">
                <div class="d-flex align-items-start gap-3">
                    <img src="/assets/imgs/defaults-images/icons/cookies-policy.png" style="max-height: 36px;" alt="Cookie">
                    <p class="mb-0 small text-muted">
                        Usiamo cookie tecnici necessari al funzionamento del sito.
                        Puoi accettare anche le categorie opzionali, rifiutarle, oppure scegliere nel dettaglio.
                        <a href="{{ APP.legal.cookie_policy_url|default('/cookie-policy') }}" class="text-decoration-underline">Leggi la cookie policy</a>.
                    </p>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="cookie-reject-optional">Rifiuta opzionali</button>
                    <button type="button" class="btn btn-sm btn-primary" data-action="cookie-accept-all">Accetta tutto</button>
                    <button type="button" class="btn btn-sm btn-outline-primary" data-action="cookie-open-preferences">Personalizza</button>
                </div>
            </div>

            <div class="card card-body py-2 d-none" data-role="cookie-preferences-panel">
                <div class="small fw-semibold mb-2">Preferenze cookie</div>
                <div class="row g-2 align-items-center">
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cookie-pref-necessary" checked disabled>
                            <label class="form-check-label" for="cookie-pref-necessary">Tecnici (necessari)</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cookie-pref-preferences" data-role="cookie-pref-preferences">
                            <label class="form-check-label" for="cookie-pref-preferences">Preferenze</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cookie-pref-analytics" data-role="cookie-pref-analytics">
                            <label class="form-check-label" for="cookie-pref-analytics">Analytics</label>
                        </div>
                    </div>
                    <div class="col-md-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="cookie-pref-marketing" data-role="cookie-pref-marketing">
                            <label class="form-check-label" for="cookie-pref-marketing">Marketing</label>
                        </div>
                    </div>
                </div>
                <div class="d-flex justify-content-end mt-2">
                    <button type="button" class="btn btn-sm btn-primary" data-action="cookie-save-preferences">Salva preferenze</button>
                </div>
            </div>
        </div>
    </div>
</div>
