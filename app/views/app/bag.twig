{% extends theme_shell('game', 'app/layouts/layout.twig') %}

{% block content %}

<main class="container-fluid">
    <section id="bag-page" class="row g-3 ui-page pb-3" data-character-id="{{ session('character_id')|e('html_attr') }}">
        <header class="col-12 ui-page-header">
            <h4 class="display-6 mt-3">Inventario</h4>
            <h6>Gestisci gli oggetti del personaggio e organizzali per categoria.</h6>
        </header>
        <hr class="w-75 ms-2" />

        <aside class="col-12 col-xl-3">
            <div class="card bag-detail-card">
                <div class="card-header">
                    <h2 class="h6 mb-0">Dettaglio oggetto</h2>
                </div>
                <div class="card-body" id="bag-detail-panel" data-role="bag-detail-panel">
                    <p class="text-muted small mb-0">Seleziona uno slot dell'inventario per vedere dettagli e azioni disponibili.</p>
                </div>
                {{ slot('game.bag.detail.after', {'character_id': session('character_id')}) }}
            </div>
        </aside>

        <section class="col-12 col-xl-9">
            <div class="card bag-grid-card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="bag-capacity-summary" data-role="bag-capacity-summary" aria-live="polite">
                        <span class="bag-capacity-summary__count">-- / -- slot</span>
                        <span class="bag-capacity-summary__meta">Capienza inventario</span>
                    </div>
                    <div class="d-flex align-items-center flex-wrap gap-2">
                        <button type="button" class="btn btn-sm btn-outline-warning" data-action="bag-reorganize">
                            <i class="bi bi-grid-3x3-gap me-1" aria-hidden="true"></i>
                            Riorganizza
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <div id="grid-bag"></div>
                </div>
            </div>
        </section>
    </section>
</main>

{% endblock %}


