{% extends theme_shell('public', 'layouts/layout.twig') %}

{% block content %}
<main>
    <header class="py-5 text-center docs-hero">
        <div class="bg-light my-5 py-4">
            <h1 class="display-5 my-3">{{ page_title }}</h1>
            <h2 class="h5 text-muted mb-3">{{ page_subtitle }}</h2>
            {% if page_version is not empty %}
            <div class="small text-muted">
                Versione {{ page_version }}
                {% if page_updated_at is not empty %}&bull; aggiornata il {{ page_updated_at }}{% endif %}
            </div>
            {% endif %}
        </div>
    </header>

    <div class="container my-5">
        <div class="card card-body">
            {% if intro_text is not empty %}
            <p class="mb-4">{{ intro_text }}</p>
            {% endif %}

            {% for section in sections %}
            <section class="mb-4">
                <h3 class="h5">{{ section.title }}</h3>
                {% if section.items is iterable %}
                <ul class="mb-0">
                    {% for item in section.items %}
                    <li>{{ item }}</li>
                    {% endfor %}
                </ul>
                {% endif %}
            </section>
            {% endfor %}

            {% if privacy_contact_email is not empty %}
            <hr>
            <p class="small text-muted mb-0">
                Per richieste privacy puoi contattarci a
                <a href="mailto:{{ privacy_contact_email }}">{{ privacy_contact_email }}</a>.
            </p>
            {% endif %}
        </div>
    </div>
</main>
{% endblock %}
