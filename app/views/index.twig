{% extends theme_shell('public', 'layouts/layout.twig') %}

{% block content %}
{% set system = system_state|default({}) %}
{% set googleAuth = google_auth|default({}) %}

<main>
    <section class="home-hero d-flex align-items-center">
        <div class="container">
            <div class="home-hero__panel text-center mx-auto p-4 p-lg-5 rounded border shadow-sm">
                <div class="mb-4 d-flex flex-column flex-md-row justify-content-center align-items-center gap-3">
                    <img src="{{ APP.brand_logo_icon }}" alt="{{ APP.name }}" height="56" class="d-inline-block">
                    <img src="{{ APP.brand_logo_wordmark }}" alt="{{ APP.name }}" height="46" class="d-inline-block">
                </div>
                <h1 class="display-6 mb-3">Benvenuto in Logeon</h1>
                <p class="lead mb-3">Hai appena installato il motore open-source per creare il tuo mondo play-by-chat: pronto a partire.</p>
                <p class="mb-4 text-muted">Questa homepage è una base iniziale: puoi personalizzarla liberamente con lo stile e i contenuti del tuo progetto.</p>
                <div class="d-flex flex-wrap justify-content-center gap-2">
                    <button type="button" class="btn btn-primary" data-action="open-signin-modal">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Entra e inizia
                    </button>
                    <a href="#" class="btn btn-outline-secondary" data-action="open-license-modal">
                        <i class="bi bi-file-earmark-text me-1"></i> Licenza
                    </a>
                </div>
            </div>
        </div>
    </section>

    <section class="py-5">
        <div class="container">
            <div class="row g-3 g-lg-4">
                <div class="col-12 col-lg-7">
                    <article class="card card-body h-100">
                        <h2 class="h4 mb-3">Primi Passi</h2>
                        <p class="text-muted mb-3">Se stai configurando una nuova istanza, questi sono i punti consigliati da completare per primi.</p>
                        <div class="list-group">
                            <div class="list-group-item d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <div class="fw-semibold">1. Imposta ambientazione e tono</div>
                                    <div class="small text-muted">Definisci identità e obiettivo narrativo del progetto.</div>
                                </div>
                                <a class="btn btn-sm btn-outline-primary flex-shrink-0" href="/storyboard">Apri</a>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <div class="fw-semibold">2. Pubblica regole e guida</div>
                                    <div class="small text-muted">Rendi chiaro il flusso di gioco per utenti e staff.</div>
                                </div>
                                <a class="btn btn-sm btn-outline-primary flex-shrink-0" href="/rules">Regole</a>
                            </div>
                            <div class="list-group-item d-flex justify-content-between align-items-start gap-3">
                                <div>
                                    <div class="fw-semibold">3. Completa la guida operativa</div>
                                    <div class="small text-muted">Definisci onboarding e procedure iniziali.</div>
                                </div>
                                <a class="btn btn-sm btn-outline-primary flex-shrink-0" href="/how-to-play">Guida</a>
                            </div>
                        </div>
                    </article>
                </div>
                <div class="col-12 col-lg-5">
                    <article class="card card-body h-100">
                        <h2 class="h4 mb-3">Informazioni Installazione</h2>
                        <div class="row g-3">
                            <div class="col-12">
                                <div class="small text-muted">Versione Core</div>
                                <div class="fw-semibold">{{ system.version|default(APP_RELEASE.installed_version|default('0.0.0')) }}</div>
                            </div>
                            <div class="col-12">
                                <div class="small text-muted">Canale Aggiornamenti</div>
                                <div class="fw-semibold">{{ system.update_channel|default(APP_RELEASE.update_channel|default('stable')) }}</div>
                            </div>
                            <div class="col-12">
                                <div class="small text-muted">Distribuzione</div>
                                <div class="fw-semibold">{{ system.distribution|default(APP_RELEASE.distribution|default('legacy')) }}</div>
                            </div>
                        </div>
                    </article>
                </div>
            </div>
        </div>
    </section>
</main>

{% include 'sys/modals/license.twig' %}
<script id="google-auth-context" type="application/json">{{ googleAuth|json_encode|raw }}</script>
{% endblock %}
