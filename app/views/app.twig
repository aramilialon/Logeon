{% extends theme_shell('game', 'app/layouts/layout.twig') %}

{% block content %}
<section id="home-page" class="container-fluid ui-page py-3 px-2 px-md-3 px-xl-4" data-home-dashboard data-character-id="{{ session('character_id')|default(0) }}">
    <section class="card mb-4">
        <div class="card-body p-4">
            <div class="row g-3 align-items-center">
                <div class="col-12 col-lg-8">
                    <h1 class="h3 mb-1">Bentornato, {{ character_name|default('') }}</h1>
                </div>
                <div class="col-12 col-lg-4">
                    {% set session_resume = session_position.resume_url|default('/game/maps') %}
                    <div class="d-flex flex-wrap gap-2 justify-content-lg-end">
                        <a class="btn btn-primary" href="{{ session_resume }}">Riprendi posizione</a>
                        <a class="btn btn-outline-secondary" href="/game/profile">Scheda personaggio</a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="row g-4">
        <div class="col-12 col-xl-8">
            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h6 mb-0">Scheda rapida personaggio</h2>
                </div>
                <div class="card-body">
                    <div class="row g-3 mb-3">
                        <div class="col-12 col-lg-6">
                            <div class="small text-muted mb-1">Integrit&agrave;</div>
                            <div class="progress mb-1" role="progressbar" aria-label="Integrita personaggio" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar bg-danger" data-role="home-health-bar" style="width:0%"></div>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span data-role="home-health-label">- / -</span>
                                <span class="badge text-bg-secondary" data-role="home-health-state">-</span>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="small text-muted mb-1">Esperienza</div>
                            <div class="progress mb-1" role="progressbar" aria-label="Esperienza personaggio" aria-valuemin="0" aria-valuemax="100">
                                <div class="progress-bar bg-info" data-role="home-experience-bar" style="width:0%"></div>
                            </div>
                            <div class="d-flex justify-content-between small">
                                <span data-role="home-experience-label">- / -</span>
                                <span data-role="home-experience-percent">-</span>
                            </div>
                        </div>
                    </div>
                    <div class="row g-2 small">
                        <div class="col-6 col-lg-3">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted">Rango</div>
                                <div class="fw-semibold" data-role="home-rank">-</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted">Gilda principale</div>
                                <div class="fw-semibold" data-role="home-primary-guild">-</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted">Contanti</div>
                                <div class="fw-semibold" data-role="home-money">-</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted">Banca</div>
                                <div class="fw-semibold" data-role="home-bank">-</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted">Prossimo rango</div>
                                <div class="fw-semibold" data-role="home-next-rank">-</div>
                            </div>
                        </div>
                        <div class="col-6 col-lg-3">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted">Ruolo in gilda</div>
                                <div class="fw-semibold" data-role="home-guild-role">-</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6">
                            <div class="border rounded p-2 h-100">
                                <div class="d-flex justify-content-between align-items-start gap-2">
                                    <div>
                                        <div class="text-muted">Fase personaggio</div>
                                        <div class="fw-semibold" data-role="home-lifecycle-name">-</div>
                                        <div class="small text-muted" data-role="home-lifecycle-description">Nessuna fase attiva.</div>
                                    </div>
                                    <span class="badge text-bg-secondary" data-role="home-lifecycle-code">-</span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="h6 mb-0">Attivit&agrave; recenti</h3>
                    <a href="#" class="small text-decoration-none" data-bs-toggle="offcanvas" data-bs-target="#offcanvasNarrativeEvents" aria-controls="offcanvasNarrativeEvents">Vedi tutto</a>
                </div>
                <div class="list-group list-group-flush home-recent-activity-list">
                    {% set source_labels = {
                        'conflict': 'Conflitto',
                        'faction': 'Fazione',
                        'system_event': 'Evento',
                        'lifecycle': 'Ciclo vita',
                        'manual': 'Manuale',
                        'system': 'Sistema'
                    } %}
                    {% set source_icons = {
                        'conflict': '/assets/imgs/defaults-images/icons/last-activity-conflict.png',
                        'faction': '/assets/imgs/defaults-images/icons/last-activity-faction.png',
                        'system_event': '/assets/imgs/defaults-images/icons/last-activity-event.png',
                        'lifecycle': '/assets/imgs/defaults-images/icons/last-activity-lifecycle.png',
                        'manual': '/assets/imgs/defaults-images/icons/last-activity-manual.png',
                        'system': '/assets/imgs/defaults-images/icons/last-activity-event.png'
                    } %}
                    {% if recent_events|default([])|length > 0 %}
                        {% for event in recent_events|slice(0, 8) %}
                            {% set event_source = event.source_system|default('manual') %}
                            {% set event_label_default = event_source|replace({'_': ' '})|title %}
                            {% set event_label = source_labels[event_source]|default(event_label_default|default('Evento')) %}
                            {% set event_icon = source_icons[event_source]|default('/assets/imgs/defaults-images/icons/last-activity-event.png') %}
                            {% set event_description = (event.description|default('')|striptags)|trim %}
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-start">
                                    <div class="d-flex align-items-start gap-2">
                                        <img src="{{ event_icon }}" alt="{{ event_label }}" class="app-recent-activity-icon rounded-2 mt-1" loading="lazy" decoding="async">
                                        <div>
                                            <strong>{{ event_label }}</strong>
                                            <div class="text-muted small">
                                                {{ event.title|default('Evento') }}
                                                {% if event_description != '' %}
                                                    - {{ event_description|slice(0, 110) }}{% if event_description|length > 110 %}...{% endif %}
                                                {% endif %}
                                            </div>
                                        </div>
                                    </div>
                                    <div class="small text-muted text-end w-25">
                                        {% if event.created_at is not empty %}{{ event.created_at|date('d/m H:i') }}{% else %}-{% endif %}
                                    </div>
                                </div>
                            </div>
                        {% endfor %}
                    {% else %}
                        <div class="list-group-item">
                            <div class="d-flex align-items-start gap-3 py-1">
                                <span class="bi bi-journal-x h5 text-muted mb-0 mt-1"></span>
                                <div>
                                    <div class="fw-semibold">Attivit&agrave; recenti vuote</div>
                                    <div class="text-muted small">Non ci sono ancora eventi da mostrare.</div>
                                </div>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-4">
            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="h6 mb-0">Da gestire ora</h3>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            PM non letti
                            <span class="badge text-bg-primary">{{ notifications.pm_unread|default(0) }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Inviti location in sospeso
                            <span class="badge text-bg-warning">{{ notifications.pending_invites|default(0) }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Notifiche non lette
                            <span class="badge text-bg-info">{{ notifications.unread_total|default(0) }}</span>
                        </li>
                        <li class="list-group-item d-flex justify-content-between align-items-center">
                            Conferme da gestire
                            <span class="badge text-bg-danger">{{ notifications.pending_actions|default(0) }}</span>
                        </li>
                    </ul>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h3 class="h6 mb-0">Posizione personaggio</h3>
                </div>
                <div class="card-body">
                    {% set session_state = session_position.state|default('maps') %}
                    {% set session_resume = session_position.resume_url|default('/game/maps') %}
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="badge text-bg-secondary">{{ session_position.state_label|default('Alle mappe') }}</span>
                        {% if session_state == 'location' %}
                            <span class="badge text-bg-success">In chat</span>
                        {% endif %}
                    </div>
                    <div class="small mb-3">
                        {% if session_state == 'location' %}
                            <div><strong>{{ session_position.location_name|default('Location') }}</strong></div>
                            <div class="text-muted">{{ session_position.map_name|default('Mappa') }}</div>
                        {% elseif session_state == 'map' %}
                            <div><strong>{{ session_position.map_name|default('Mappa') }}</strong></div>
                            <div class="text-muted">Nessuna location attiva</div>
                        {% else %}
                            <div class="text-muted">Il personaggio &egrave; alle mappe.</div>
                        {% endif %}
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="/game/maps" class="btn btn-primary btn-sm">Apri mappe</a>
                        {% if session_resume != '/game/maps' %}
                            <a href="{{ session_resume }}" class="btn btn-outline-secondary btn-sm">Riprendi posizione</a>
                        {% endif %}
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="h6 mb-0">Inventario ed equip</h3>
                </div>
                <div class="card-body">
                    <div class="row g-2 small mb-3">
                        <div class="col-6">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted">Slot usati</div>
                                <div class="fw-semibold"><span data-role="home-inventory-used">-</span> / <span data-role="home-inventory-max">-</span></div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted">Slot liberi</div>
                                <div class="fw-semibold" data-role="home-inventory-free">-</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted">Oggetti in borsa</div>
                                <div class="fw-semibold" data-role="home-inventory-total-items">-</div>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="border rounded p-2 h-100">
                                <div class="text-muted">Equipaggiati</div>
                                <div class="fw-semibold"><span data-role="home-equipped-items">-</span> / <span data-role="home-equip-slots-total">-</span></div>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex flex-wrap gap-2">
                        <a href="/game/bag" class="btn btn-outline-primary btn-sm">Apri inventario</a>
                        <a href="/game/equips" class="btn btn-outline-secondary btn-sm">Apri equipaggiamento</a>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h3 class="h6 mb-0">Azioni rapide</h3>
                </div>
                <div class="card-body">
                    <div class="row g-2">
                        <div class="col-6">
                            <a href="/game/forum" class="btn btn-outline-secondary w-100 text-start">
                                <i class="bi bi-chat-left-quote me-1"></i>Forum
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="#" class="btn btn-outline-secondary w-100 text-start" data-action="open-inbox" data-requires-auth>
                                <i class="bi bi-envelope me-1"></i>Messaggi
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="#" class="btn btn-outline-secondary w-100 text-start" data-bs-toggle="offcanvas" data-bs-target="#offcanvasSystemEvents" aria-controls="offcanvasSystemEvents">
                                <i class="bi bi-calendar-event me-1"></i>Eventi
                            </a>
                        </div>
                        <div class="col-6">
                            <a href="/game/shop" class="btn btn-outline-secondary w-100 text-start">
                                <i class="bi bi-shop me-1"></i>Negozio
                            </a>
                        </div>
                    </div>
                    <div class="mt-2">
                        {{ slot('game.home.quick_actions') }}
                    </div>
                </div>
            </div>
        </div>
    </section>
</section>
{% endblock %}

