<div class="d-flex justify-content-between align-items-center mb-3">
    <header class="mt-3">
        <h4 class="display-6">Log consegna email</h4>
        <h6>Storico delle spedizioni per campagna</h6>
    </header>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-outline-primary" data-action="admin-mail-logs-reload">
            <i class="bi bi-arrow-clockwise me-1"></i>Aggiorna
        </button>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form id="admin-mail-logs-filters" class="row g-2 align-items-end" autocomplete="off" novalidate>
            <div class="col-auto">
                <label class="form-label mb-1">Campagna</label>
                <select name="message_id" class="form-select" id="admin-mail-logs-campaign">
                    <option value="">Tutte</option>
                </select>
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">Stato</label>
                <select name="status" class="form-select">
                    <option value="">Tutti</option>
                    <option value="pending">In attesa</option>
                    <option value="sending">In invio</option>
                    <option value="sent">Inviata</option>
                    <option value="failed">Fallita</option>
                </select>
            </div>
            <div class="col-auto">
                <a class="btn btn-sm btn-outline-secondary" href="/admin/mail-logs">Reset</a>
            </div>
        </form>
    </div>
</div>

<div id="grid-admin-mail-logs"></div>
