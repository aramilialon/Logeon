<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-3 mt-3">
    <header>
        <h4 class="display-6 mb-1">Media Manager</h4>
        <h6 class="mb-0">Gestione sicura di asset statici in <code>/uploads/media</code>.</h6>
    </header>
    <div class="d-flex flex-wrap gap-2 admin-page-actions">
        <button type="button" class="btn btn-sm btn-outline-primary" data-action="media-reload">
            <i class="bi bi-arrow-clockwise me-1"></i>Aggiorna
        </button>
        <button type="button" class="btn btn-sm btn-primary" data-action="media-upload-trigger" data-requires-capability="media.upload">
            <i class="bi bi-upload me-1"></i>Carica file
        </button>
    </div>
</div>

<nav aria-label="breadcrumb" class="mb-3">
    <ol id="media-breadcrumb" class="breadcrumb mb-0"></ol>
</nav>

<div class="row g-3 mb-3">
    <div class="col-12 col-xl-8">
        <div class="card h-100">
            <div class="card-body">
                <div id="media-dropzone" class="admin-media-dropzone rounded-3 p-4 text-center" data-requires-capability="media.upload">
                    <div class="d-flex flex-column align-items-center gap-2">
                        <i class="bi bi-cloud-arrow-up fs-2 text-muted"></i>
                        <div class="fw-semibold">Trascina qui i file da caricare</div>
                        <div class="small text-muted">Oppure clicca per aprire il selettore file</div>
                    </div>
                </div>
                <input type="file" id="media-file-input" class="d-none" multiple accept=".jpg,.jpeg,.png,.webp,.gif,.txt,.md">
                <div id="media-limit-note" class="small text-muted mt-3"></div>
            </div>
        </div>
    </div>
    <div class="col-12 col-xl-4">
        <div id="media-folder-actions" class="card h-100">
            <div class="card-body d-flex flex-column justify-content-between gap-3">
                <div>
                    <div class="small text-muted text-uppercase fw-semibold mb-2">Cartella corrente</div>
                    <div id="media-current-folder-label" class="fw-semibold">Media</div>
                    <div class="small text-muted mt-1">Le cartelle possono essere eliminate solo se vuote.</div>
                </div>
                <div class="d-flex flex-wrap gap-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-action="media-create-folder" data-requires-capability="media.manage_folders">
                        <i class="bi bi-folder-plus me-1"></i>Nuova cartella
                    </button>
                    <button type="button" id="media-rename-folder-btn" class="btn btn-sm btn-outline-secondary d-none" data-action="media-rename-folder" data-requires-capability="media.manage_folders">
                        <i class="bi bi-pencil me-1"></i>Rinomina
                    </button>
                    <button type="button" id="media-delete-folder-btn" class="btn btn-sm btn-outline-danger d-none" data-action="media-delete-folder" data-requires-capability="media.manage_folders">
                        <i class="bi bi-trash me-1"></i>Elimina
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="card mb-3">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0">Cartelle</h6>
        <span class="small text-muted">Prima le cartelle, poi i file</span>
    </div>
    <div class="card-body">
        <div id="media-folders-container" class="row g-2"></div>
        <div id="media-folders-empty" class="small text-muted d-none">Nessuna sottocartella presente.</div>
    </div>
</div>

<div class="card">
    <div class="card-header d-flex flex-wrap justify-content-between align-items-center gap-2">
        <h6 class="mb-0">File</h6>
        <div id="media-bulk-actions" class="d-none">
            <button type="button" class="btn btn-sm btn-outline-danger" data-action="media-bulk-delete" data-requires-capability="media.delete_own">
                <i class="bi bi-trash me-1"></i>Elimina selezionati (<span id="media-selected-count">0</span>)
            </button>
        </div>
    </div>
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th scope="col" class="text-center admin-media-col-check">
                            <div class="form-check form-check-inline justify-content-center mb-0 admin-media-check">
                                <input id="media-file-select-all" type="checkbox" class="form-check-input" aria-label="Seleziona tutti i file">
                            </div>
                        </th>
                        <th scope="col">Nome</th>
                        <th scope="col" class="admin-media-col-type">Tipo</th>
                        <th scope="col" class="admin-media-col-size">Dimensione</th>
                        <th scope="col" class="admin-media-col-date">Upload</th>
                        <th scope="col" class="admin-media-col-author">Autore</th>
                        <th scope="col" class="text-end admin-media-col-actions">Azioni</th>
                    </tr>
                </thead>
                <tbody id="media-files-table-body"></tbody>
            </table>
        </div>
        <div id="media-files-empty" class="small text-muted px-3 py-4 d-none">Nessun file presente in questa cartella.</div>
    </div>
</div>

<div id="media-upload-progress" class="card mt-3 d-none">
    <div class="card-body">
        <div class="d-flex justify-content-between align-items-center mb-2">
            <small id="media-upload-status">Upload in corso...</small>
            <span id="media-upload-percent">0%</span>
        </div>
        <div class="progress">
            <div id="media-upload-bar" class="progress-bar" role="progressbar" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
        </div>
    </div>
</div>

{% include 'admin/modals/media.twig' %}
