<div class="d-flex justify-content-between align-items-center mb-3">
    <header class="mt-3">
        <h4 class="display-6">Campagne email</h4>
        <h6>Gestione invii massivi e campagne di comunicazione</h6>
    </header>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-sm btn-outline-primary" data-action="admin-mail-campaigns-reload">
            <i class="bi bi-arrow-clockwise me-1"></i>Aggiorna
        </button>
        <button type="button" class="btn btn-sm btn-primary" data-action="admin-mail-campaigns-create">
            <i class="bi bi-plus-lg me-1"></i>Nuova campagna
        </button>
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <form id="admin-mail-campaigns-filters" class="row g-2 align-items-end" autocomplete="off" novalidate>
            <div class="col-auto">
                <label class="form-label mb-1">Cerca</label>
                <input name="query" type="text" class="form-control" maxlength="100" placeholder="Oggetto...">
            </div>
            <div class="col-auto">
                <label class="form-label mb-1">Stato</label>
                <select name="status" class="form-select">
                    <option value="">Tutti</option>
                    <option value="draft">Bozza</option>
                    <option value="scheduled">Pianificata</option>
                    <option value="queued">In coda</option>
                    <option value="sending">Invio in corso</option>
                    <option value="sent">Inviata</option>
                    <option value="failed">Fallita</option>
                    <option value="cancelled">Annullata</option>
                </select>
            </div>
            <div class="col-auto">
                <a class="btn btn-sm btn-outline-secondary" href="/admin/mail-campaigns">Reset</a>
            </div>
        </form>
    </div>
</div>

<div id="grid-admin-mail-campaigns"></div>
{% include 'admin/modals/mail-campaign.twig' %}
