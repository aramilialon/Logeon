<div class="modal fade" id="admin-mail-template-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-body">
                <div class="d-flex justify-content-end my-3 mx-4">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <h4 class="display-6 text-center mt-3 mb-2">Template Email</h4>
                <hr class="my-4" />

                <form id="admin-mail-template-form" class="row g-3">
                    <input type="hidden" name="id" value="">

                    <div class="col-12 col-md-8">
                        <label class="form-label">Nome <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="name" maxlength="255" placeholder="Nome interno del template..." required>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Categoria</label>
                        <select class="form-select" name="category">
                            <option value="transactional">Transazionale</option>
                            <option value="system">Sistema</option>
                            <option value="announcement">Annuncio</option>
                            <option value="newsletter">Newsletter</option>
                        </select>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Descrizione</label>
                        <input type="text" class="form-control" name="description" maxlength="500" placeholder="Descrizione opzionale...">
                    </div>

                    <div class="col-12">
                        <label class="form-label">Oggetto email <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="subject" maxlength="500" placeholder="Oggetto dell'email... (supporta {{ variabili }})" required>
                    </div>

                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <label class="form-label mb-0">Contenuto email</label>
                            <div class="dropdown">
                                <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="bi bi-braces me-1"></i>Inserisci variabile
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">Utente</h6></li>
                                    <li><button class="dropdown-item small" type="button" data-action="admin-mail-template-insert-var" data-var="user.username">&#123;&#123; user.username &#125;&#125; — Nome utente</button></li>
                                    <li><button class="dropdown-item small" type="button" data-action="admin-mail-template-insert-var" data-var="user.email">&#123;&#123; user.email &#125;&#125; — Email utente</button></li>
                                    <li><h6 class="dropdown-header">Personaggio</h6></li>
                                    <li><button class="dropdown-item small" type="button" data-action="admin-mail-template-insert-var" data-var="character.name">&#123;&#123; character.name &#125;&#125; — Nome PG</button></li>
                                    <li><button class="dropdown-item small" type="button" data-action="admin-mail-template-insert-var" data-var="character.full_name">&#123;&#123; character.full_name &#125;&#125; — Nome completo PG</button></li>
                                    <li><h6 class="dropdown-header">App</h6></li>
                                    <li><button class="dropdown-item small" type="button" data-action="admin-mail-template-insert-var" data-var="app.name">&#123;&#123; app.name &#125;&#125; — Nome applicazione</button></li>
                                    <li><button class="dropdown-item small" type="button" data-action="admin-mail-template-insert-var" data-var="current_year">&#123;&#123; current_year &#125;&#125; — Anno corrente</button></li>
                                    <li><h6 class="dropdown-header">Newsletter</h6></li>
                                    <li><button class="dropdown-item small" type="button" data-action="admin-mail-template-insert-var" data-var="unsubscribe_url">&#123;&#123; unsubscribe_url &#125;&#125; — Link disiscrizione</button></li>
                                    <li><button class="dropdown-item small" type="button" data-action="admin-mail-template-insert-var" data-var="preferences_url">&#123;&#123; preferences_url &#125;&#125; — Link preferenze</button></li>
                                </ul>
                            </div>
                        </div>
                        <textarea class="form-control richtext-editor" name="body_html" rows="16" id="mail-template-body-textarea"></textarea>
                    </div>
                </form>

                <div class="d-flex justify-content-between gap-2 mt-4">
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-info d-none" data-action="admin-mail-template-preview">
                            <i class="bi bi-eye me-1"></i>Anteprima
                        </button>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-outline-danger d-none" data-action="admin-mail-template-delete">Elimina</button>
                        <button type="button" class="btn btn-primary" data-action="admin-mail-template-save">Salva</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="admin-mail-template-preview-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Anteprima template</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Chiudi"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <small class="text-muted">Oggetto:</small>
                    <div class="fw-semibold" id="mail-template-preview-subject"></div>
                </div>
                <hr />
                <div id="mail-template-preview-body" class="p-3 border rounded bg-white text-dark"></div>
            </div>
        </div>
    </div>
</div>
