<div class="modal fade" id="admin-mail-campaign-modal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-body">
                <div class="d-flex justify-content-end my-3 mx-4">
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Chiudi"></button>
                </div>
                <h4 class="display-6 text-center mt-3 mb-2">Campagna email</h4>
                <hr class="my-4" />

                <form id="admin-mail-campaign-form" class="row g-3">
                    <input type="hidden" name="id" value="">

                    <div class="col-12 col-md-8">
                        <label class="form-label">Oggetto <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" name="subject" maxlength="500" required>
                    </div>
                    <div class="col-12 col-md-4">
                        <label class="form-label">Categoria</label>
                        <select class="form-select" name="category">
                            <option value="announcement">Annuncio</option>
                            <option value="newsletter">Newsletter</option>
                            <option value="system">Sistema</option>
                            <option value="transactional">Transazionale</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Lista destinatari</label>
                        <select class="form-select" name="distribution_list_id">
                            <option value="">— seleziona lista —</option>
                        </select>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Carica da template</label>
                        <div class="input-group">
                            <select class="form-select" name="template_id">
                                <option value="">— nessun template —</option>
                            </select>
                            <button type="button" class="btn btn-outline-secondary" data-action="admin-mail-campaign-load-template">Carica</button>
                        </div>
                    </div>

                    <div class="col-12">
                        <label class="form-label">Contenuto email</label>
                        <textarea class="form-control richtext-editor" name="body_html" rows="16" id="mail-campaign-body-textarea"></textarea>
                    </div>

                    <div class="col-12 col-md-6">
                        <label class="form-label">Pianifica invio</label>
                        <input type="datetime-local" class="form-control" name="scheduled_at">
                        <div class="form-text">Lascia vuoto per salvare come bozza o inviare subito.</div>
                    </div>
                </form>

                <div class="d-none mt-3" id="admin-mail-campaign-test-section">
                    <hr />
                    <div class="d-flex gap-2 align-items-end">
                        <div class="flex-grow-1">
                            <label class="form-label mb-1">Email destinatario test</label>
                            <input type="email" class="form-control form-control-sm" id="admin-mail-campaign-test-email" placeholder="test@esempio.com">
                        </div>
                        <button type="button" class="btn btn-sm btn-info" data-action="admin-mail-campaign-send-test-confirm">Invia</button>
                        <button type="button" class="btn btn-sm btn-outline-secondary" data-action="admin-mail-campaign-test-cancel">Annulla</button>
                    </div>
                </div>

                <div class="d-flex justify-content-between gap-2 mt-4">
                    <div>
                        <button type="button" class="btn btn-outline-danger d-none" data-action="admin-mail-campaign-delete">Elimina</button>
                    </div>
                    <div class="d-flex gap-2 align-items-center flex-wrap">
                        <button type="button" class="btn btn-sm btn-outline-info d-none" data-action="admin-mail-campaign-test-open">
                            <i class="bi bi-envelope me-1"></i>Invia test
                        </button>
                        <button type="button" class="btn btn-outline-secondary d-none" data-action="admin-mail-campaign-cancel">Annulla invio</button>
                        <button type="button" class="btn btn-outline-primary d-none" data-action="admin-mail-campaign-schedule">Pianifica</button>
                        <button type="button" class="btn btn-warning d-none" data-action="admin-mail-campaign-send-now">Invia ora</button>
                        <button type="button" class="btn btn-primary d-none" data-action="admin-mail-campaign-save">Salva bozza</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
