{% extends theme_shell('public', 'layouts/layout.twig') %}

{% block content %}
{% set unsubscribe = unsubscribe|default({}) %}
{% set status = unsubscribe.status|default('invalid') %}
{% set message = unsubscribe.message|default('Disiscrizione non riuscita.') %}
{% set isSuccess = status == 'success' or status == 'already_unsubscribed' %}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7">
            <div class="card shadow-sm">
                <div class="card-body text-center p-4 p-lg-5">
                    <h4 class="mb-3">{{ isSuccess ? 'Preferenze aggiornate' : 'Disiscrizione newsletter' }}</h4>
                    <p class="text-muted mb-4">{{ message }}</p>

                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                        <a class="btn btn-outline-secondary" href="/">Torna alla homepage</a>
                        {% if isSuccess %}
                            <a class="btn btn-primary" href="/game/settings">Gestisci preferenze</a>
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}
